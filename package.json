{
  "name": "healthbridge",
  "private": true,
  "version": "0.1.0",
  "description": "HealthBridge: online-first continuity of care with trusted local doctors.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "shared",
    "backend",
    "frontend",
    "e2e"
  ],
  "scripts": {
    "start": "node scripts/start.mjs",
    "stop": "docker compose --profile observability --profile scanner --profile video stop",
    "logs": "docker compose logs -f --tail=100",
    "reset": "docker compose --profile observability --profile scanner --profile video down -v --remove-orphans",
    "check": "node scripts/check.mjs",
    "env:init": "node scripts/generate-env.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
