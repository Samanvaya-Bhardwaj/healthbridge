{
  "uid": "healthbridge-overview",
  "title": "HealthBridge overview",
  "tags": ["healthbridge"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Services up",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=~\"api|worker|ai-service\"})"
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "API 5xx ratio (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_request_duration_seconds_count{status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_request_duration_seconds_count[5m])), 1e-9)"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Dead-lettered jobs (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(queue_jobs_dlq_total[24h]))"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Browser errors (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(client_errors_total[1h]))"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "API requests by status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_code) (rate(http_request_duration_seconds_count[5m]))",
          "legendFormat": "{{status_code}}"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "API latency",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Slowest routes (p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(5, histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[5m]))))",
          "legendFormat": "{{route}}"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Outbox",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(outbox_events_created_total[5m]))",
          "legendFormat": "created"
        },
        {
          "refId": "B",
          "expr": "sum(rate(outbox_events_dispatched_total[5m]))",
          "legendFormat": "relayed"
        },
        {
          "refId": "C",
          "expr": "sum(rate(outbox_events_failed_total[5m]))",
          "legendFormat": "failed"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Jobs by queue",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (rate(queue_jobs_processed_total[5m]))",
          "legendFormat": "{{queue}} done"
        },
        {
          "refId": "B",
          "expr": "sum by (queue) (rate(queue_jobs_failed_total[5m]))",
          "legendFormat": "{{queue}} failed"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Payments",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(payments_succeeded_total[15m]))",
          "legendFormat": "succeeded"
        },
        {
          "refId": "B",
          "expr": "sum(rate(payments_failed_total[15m]))",
          "legendFormat": "failed"
        },
        {
          "refId": "C",
          "expr": "sum by (reason) (rate(payment_webhooks_invalid_total[15m]))",
          "legendFormat": "webhook rejected {{reason}}"
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Access control",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(consent_denied_total[15m]))",
          "legendFormat": "consent denied"
        },
        {
          "refId": "B",
          "expr": "sum(rate(document_access_denied_total[15m]))",
          "legendFormat": "document access denied"
        }
      ],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "LLM calls",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (workflow, status) (rate(ai_llm_calls_total[15m]))",
          "legendFormat": "{{workflow}} {{status}}"
        }
      ],
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "LLM latency p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, workflow) (rate(ai_llm_call_duration_seconds_bucket[15m])))",
          "legendFormat": "{{workflow}}"
        }
      ],
      "id": 13
    },
    {
      "type": "timeseries",
      "title": "LLM tokens and spend",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction) (rate(ai_llm_tokens_total[1h]))*3600",
          "legendFormat": "{{direction}} tokens/h"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ai_llm_estimated_cost_usd_total[1h]))*3600",
          "legendFormat": "USD/h"
        }
      ],
      "id": 14
    }
  ],
  "description": "Service health, background jobs, payments, access denials and AI usage. Metadata only."
}
