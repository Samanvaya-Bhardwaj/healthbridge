{
  "family": "healthbridge-${HB_ENV}-web",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/healthbridge-${HB_ENV}-execution",
  "volumes": [
    {
      "name": "tmp"
    }
  ],
  "containerDefinitions": [
    {
      "name": "web",
      "image": "${IMAGE_REGISTRY}/healthbridge-web:${IMAGE_TAG}",
      "essential": true,
      "readonlyRootFilesystem": false,
      "mountPoints": [],
      "linuxParameters": {
        "initProcessEnabled": true,
        "capabilities": {
          "drop": ["ALL"]
        }
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/healthbridge/${HB_ENV}/web",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "web",
          "awslogs-create-group": "true",
          "mode": "non-blocking"
        }
      },
      "portMappings": [
        {
          "name": "web",
          "containerPort": 8080,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        {
          "name": "HB_TLS",
          "value": "off"
        },
        {
          "name": "HB_STORAGE_PROXY",
          "value": "off"
        },
        {
          "name": "HB_CSP_CONNECT_EXTRA",
          "value": "https://${S3_BUCKET_DOCUMENTS}.s3.${AWS_REGION}.amazonaws.com"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1"],
        "interval": 15,
        "timeout": 3,
        "retries": 3,
        "startPeriod": 10
      }
    }
  ],
  "tags": [
    {
      "key": "app",
      "value": "healthbridge"
    },
    {
      "key": "env",
      "value": "${HB_ENV}"
    }
  ]
}
