# HealthBridge environment variables.
#
# This file lists variable NAMES only. Do not put real values here.
# For local development, generate a .env with random secrets:
#     node scripts/generate-env.mjs
# Production secrets come from the deployment platform's secret manager.

# ── Runtime ───────────────────────────────────────────────────
# development | test | staging | production
APP_ENV=
# Synthetic demo data mode. Must be false in production.
DEMO_MODE=
LOG_LEVEL=

# ── PostgreSQL ────────────────────────────────────────────────
DB_HOST=
DB_PORT=
POSTGRES_DB=
# Owner / migration role (runs migrations only; never used by running services)
POSTGRES_USER=
POSTGRES_PASSWORD=
# Least-privilege runtime role for the Node backend
DB_APP_USER=
DB_APP_PASSWORD=
# Least-privilege runtime role for the AI service
DB_AI_USER=
DB_AI_PASSWORD=
DB_POOL_MAX=

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# ── Object storage (S3 API; MinIO locally) ────────────────────
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_DOCUMENTS=
S3_FORCE_PATH_STYLE=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ── Email (Mailpit locally) ───────────────────────────────────
SMTP_HOST=
SMTP_PORT=
MAIL_FROM=

# ── Backend API ───────────────────────────────────────────────
API_PORT=
METRICS_PORT=
# Comma-separated list of allowed browser origins
CORS_ORIGINS=
# Number of trusted reverse-proxy hops (1 behind the bundled Nginx)
TRUST_PROXY=

# ── Internal service-to-service auth (backend → AI service) ───
AI_SERVICE_URL=
# Shared HS256 key, at least 32 random characters
INTERNAL_SERVICE_SECRET=

# ── AI service / LLM provider ─────────────────────────────────
# claude | fake  (fake = deterministic, offline, used by tests and CI)
LLM_PROVIDER=
ANTHROPIC_API_KEY=
LLM_MODEL_DEFAULT=
LLM_MODEL_FAST=
LLM_TIMEOUT_SECONDS=
LLM_MAX_RETRIES=
# Server-side refusal fallback for supported Claude models (true|false)
LLM_REFUSAL_FALLBACK=
# Must be explicitly true before an external LLM may run with APP_ENV=production.
# Set it only after the privacy/security/compliance review in ADR-0008.
LLM_EXTERNAL_PROCESSING_APPROVED=
