# HealthBridge environment variables.
#
# This file lists variable NAMES only. Do not put real values here.
# For local development, generate a .env with random secrets:
#     node scripts/generate-env.mjs
# Production secrets come from the deployment platform's secret manager.

# ── Runtime ───────────────────────────────────────────────────
# development | test | staging | production
APP_ENV=
# Synthetic demo data mode. Must be false in production.
DEMO_MODE=
LOG_LEVEL=

# ── PostgreSQL ────────────────────────────────────────────────
DB_HOST=
DB_PORT=
POSTGRES_DB=
# Owner / migration role (runs migrations only; never used by running services)
POSTGRES_USER=
POSTGRES_PASSWORD=
# Least-privilege runtime role for the Node backend
DB_APP_USER=
DB_APP_PASSWORD=
# Least-privilege runtime role for the AI service
DB_AI_USER=
DB_AI_PASSWORD=
DB_POOL_MAX=
# TLS to managed PostgreSQL: disable (default) | require | verify-full; CA bundle as base64 PEM
DB_SSL=
DB_SSL_CA=

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
# Managed Redis with in-transit encryption (ElastiCache): true
REDIS_TLS=

# ── Object storage (S3 API; MinIO locally) ────────────────────
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_DOCUMENTS=
S3_FORCE_PATH_STYLE=
# Browser-facing endpoint used in presigned document URLs (defaults to S3_ENDPOINT)
S3_PUBLIC_ENDPOINT=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ── Email (Mailpit locally) ───────────────────────────────────
SMTP_HOST=
SMTP_PORT=
# Relay credentials (e.g. SES SMTP); STARTTLS is required in staging/production. SMTP_SECURE=true for port 465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=
MAIL_FROM=

# ── Backend API ───────────────────────────────────────────────
API_PORT=
METRICS_PORT=
# Comma-separated list of allowed browser origins
CORS_ORIGINS=
# Web app base URL for emailed links (default: first CORS origin; https required in staging/production)
PUBLIC_APP_URL=
# Number of trusted reverse-proxy hops (1 behind the bundled Nginx)
TRUST_PROXY=

# ── Internal service-to-service auth (backend → AI service) ───
AI_SERVICE_URL=
# Shared HS256 key, at least 32 random characters
INTERNAL_SERVICE_SECRET=

# ── AI service / LLM provider ─────────────────────────────────
# claude | fake  (fake = deterministic, offline, used by tests and CI)
LLM_PROVIDER=
ANTHROPIC_API_KEY=
LLM_MODEL_DEFAULT=
LLM_MODEL_FAST=
LLM_TIMEOUT_SECONDS=
LLM_MAX_RETRIES=
# Server-side refusal fallback for supported Claude models (true|false)
LLM_REFUSAL_FALLBACK=
# Must be explicitly true before an external LLM may run with APP_ENV=production.
# Set it only after the privacy/security/compliance review in ADR-0008.
LLM_EXTERNAL_PROCESSING_APPROVED=
# hashing | voyage (hashing = deterministic, offline; voyage = external, same approval gate)
EMBEDDING_PROVIDER=
VOYAGE_API_KEY=
VOYAGE_MODEL=

# ── Authentication (ADR-0015) ─────────────────────────────────
# Ed25519 private key (PKCS#8 PEM, base64-encoded). Generated locally; from a secret
# manager in staging/production.
AUTH_JWT_PRIVATE_KEY=
# Optional comma-separated previous public keys (SPKI PEM, base64) during key rotation
AUTH_JWT_PREVIOUS_PUBLIC_KEYS=
AUTH_ACCESS_TOKEN_TTL_SECONDS=
SESSION_IDLE_TTL_MINUTES=
SESSION_ABSOLUTE_TTL_HOURS=
PRIVILEGED_SESSION_IDLE_TTL_MINUTES=
PRIVILEGED_SESSION_ABSOLUTE_TTL_HOURS=
# Must be true outside development/test (enforced at startup)
AUTH_COOKIE_SECURE=

# ── Demo mode ─────────────────────────────────────────────────
# Password for synthetic demo accounts (local/demo environments only)
DEMO_USER_PASSWORD=

# ── Payments (ADR-0020) ───────────────────────────────────────
# fake | razorpay. fake = deterministic, offline, no money moves (refused in production)
PAYMENT_PROVIDER=
# HMAC secret for provider webhooks (Razorpay: the dashboard webhook secret)
PAYMENT_WEBHOOK_SECRET=
# Razorpay API keys (rzp_test_… outside production; rzp_live_… only in production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_PROVIDER_TIMEOUT_MS=

# ── Notifications ─────────────────────────────────────────────
# fake | smtp (Mailpit locally). fake is refused in production
NOTIFICATION_EMAIL_PROVIDER=
# Reminder lead times in minutes, comma-separated (default 1440,60)
REMINDER_OFFSETS_MINUTES=

# ── Workers ───────────────────────────────────────────────────
WORKER_METRICS_PORT=
# Bull Board (read-only queue view, worker-internal; published on 127.0.0.1 only).
# Disabled unless BULL_BOARD_PASSWORD is set (16+ characters).
BULL_BOARD_PORT=
BULL_BOARD_USERNAME=
BULL_BOARD_PASSWORD=
# Host port for the board (compose, default 3010)
BULL_BOARD_HOST_PORT=
QUEUE_PREFIX=
JOB_MAX_ATTEMPTS=
JOB_BACKOFF_MS=
OUTBOX_POLL_INTERVAL_MS=
OUTBOX_MAX_ATTEMPTS=
HOLD_SWEEP_INTERVAL_MS=
REMINDER_SWEEP_INTERVAL_MS=

# ── Medical documents (ADR-0021) ──────────────────────────────
# fake | clamav. fake = deterministic test scanner, NO malware protection (refused in
# staging/production)
DOCUMENT_SCANNER=
CLAMAV_HOST=
CLAMAV_PORT=
DOCUMENT_MAX_BYTES=
DOCUMENT_UPLOAD_URL_TTL_SECONDS=
# Short-lived signed download URLs (1-300 seconds; default 60)
DOCUMENT_DOWNLOAD_URL_TTL_SECONDS=

# ── Consultations (ADR-0025) ──────────────────────────────────
# mock | livekit. mock = signed tokens for a placeholder room, no media (refused in production)
VIDEO_PROVIDER=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VIDEO_TOKEN_TTL_SECONDS=
# Key-encryption key for clinical notes: base64 of 32 random bytes. Required in
# staging/production; development derives one from INTERNAL_SERVICE_SECRET if empty.
CLINICAL_DATA_KEY=
CLINICAL_DATA_KEY_ID=
# During rotation: previous keys as keyId:base64,keyId:base64
CLINICAL_DATA_PREVIOUS_KEYS=

# ── Observability (optional profile: docker compose --profile observability up -d) ──
# Prometheus and Grafana on 127.0.0.1 only. Grafana will not start without a password.
HOST_PORT_PROMETHEUS=
HOST_PORT_GRAFANA=
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
