{
  "name": "@healthbridge/backend",
  "private": true,
  "version": "0.1.0",
  "description": "HealthBridge API: modular monolith (Express) and background workers.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "src/server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/server.js",
    "start": "node src/server.js",
    "worker": "node --env-file-if-exists=../.env src/worker.js",
    "migrate:latest": "node --env-file-if-exists=../.env scripts/migrate.js latest",
    "migrate:rollback": "node --env-file-if-exists=../.env scripts/migrate.js rollback",
    "migrate:status": "node --env-file-if-exists=../.env scripts/migrate.js status",
    "migrate:make": "knex migrate:make --knexfile knexfile.js -x js",
    "storage:bootstrap": "node --env-file-if-exists=../.env scripts/bootstrap-storage.js",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest tests/unit",
    "seed:demo": "node --env-file-if-exists=../.env scripts/seed-demo.js",
    "user:create": "node --env-file-if-exists=../.env scripts/create-user.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-presigned-post": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@bull-board/api": "^9.10.4",
    "@bull-board/express": "^9.10.4",
    "@healthbridge/shared": "0.1.0",
    "@node-rs/argon2": "^2.2.1",
    "bullmq": "^6.3.11",
    "cookie": "^0.7.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "knex": "^3.3.0",
    "luxon": "^3.7.2",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^11.2.1",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  }
}
